{
  "name": "airbnb_clone",
  "version": "1.0.0",
  "description": "WanderLodge - Full-Stack SaaS Vacation Rental Platform",
  "main": "api/index.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build && node -e \"require('fs').cpSync('frontend/dist', 'dist', {recursive: true})\"",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend start",
    "client": "npm --prefix frontend run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaganParida/WanderLodge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JaganParida/WanderLodge/issues"
  },
  "homepage": "https://github.com/JaganParida/WanderLodge#readme",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@mapbox/mapbox-sdk": "^0.16.1",
    "cloudinary": "^1.21.0",
    "concurrently": "^10.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.2",
    "helmet": "^8.3.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.17.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0"
  }
}
